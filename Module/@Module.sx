use GFX.Application
use GFX.Application.Schedule
use GFX.Application.Time as TimePlugin
use GFX.Assets.Image
use GFX.Canvas.Canvas as AuthoredCanvas
public use GFX.Canvas.Session.Session as CanvasSession
use GFX.Color
use GFX.ECS
use GFX.GPU
use GFX.GPU.Plugin as GPUPlugin
use GFX.Input as InputApi
use GFX.Input.Events
use GFX.Rendering.Plugin as RenderingPlugin
use GFX.Resources
use GFX.Scene2D
use GFX.Scene2D.Plugin as Scene2DPlugin
use GFX.Window as WindowApi
use GFX.Window.Plugin as WindowPlugin
use STD.Math

public struct ImageSettings {
    var title:str
    var width:int
    var height:int
    var background:Color
    var smooth:bool

    init(
        title:str = "GFX image viewer",
        width:int = 0,
        height:int = 0,
        background:Color = Color.slate_950(),
        smooth:bool = true
    ) {
        self.title = title
        self.width = width
        self.height = height
        self.background = background
        self.smooth = smooth
    }
}

public struct CanvasSettings {
    var title:str
    var width:int
    var height:int
    var background:Color

    init(
        width:int = 960,
        height:int = 640,
        title:str = "GFX canvas viewer",
        background:Color = Color.slate_950()
    ) {
        if width <= 0 || height <= 0 {
            panic("GFX.Viewer canvas dimensions must be positive")
        }
        self.title = title
        self.width = width
        self.height = height
        self.background = background
    }
}

package class ImageView {
    private var current_image:Image
    private var current_revision:int

    init(image:Image) {
        self.current_image = image
        self.current_revision = 1
    }

    func image() @Image { return self.current_image }
    func revision() int { return self.current_revision }

    func replace(image:Image) {
        self.current_image = image
        self.current_revision++
    }
}

class DrawingPresentation {
    var display:ECS.Entity? = null
    var display_width:int
    var display_height:int

    init() {
        self.display_width = 0
        self.display_height = 0
    }
}

func empty_drawing(width:int, height:int) AuthoredCanvas {
    return AuthoredCanvas()
}

class DrawingSource {
    private var fixed:AuthoredCanvas?
    private var builder:func(int, int) AuthoredCanvas
    private var session:CanvasSession? = null
    let responsive:bool
    let interactive:bool

    private init(
        drawing:AuthoredCanvas?,
        builder:func(int, int) AuthoredCanvas,
        responsive:bool,
        session:CanvasSession? = null,
        interactive:bool = false
    ) {
        self.fixed = drawing
        self.builder = builder
        self.session = session
        self.responsive = responsive
        self.interactive = interactive
    }

    static func fixed(drawing:AuthoredCanvas) DrawingSource {
        return DrawingSource(drawing, empty_drawing, false)
    }

    static func responsive(builder:func(int, int) AuthoredCanvas) DrawingSource {
        return DrawingSource(null, builder, true)
    }

    static func interactive(session:CanvasSession) DrawingSource {
        return DrawingSource(
            null,
            empty_drawing,
            true,
            session:session,
            interactive:true
        )
    }

    func drawing(width:int, height:int) AuthoredCanvas {
        if var content = self.session { return content.drawing(width, height) }
        if self.responsive { return self.builder(width, height) }
        if let content = self.fixed { return content }
        panic("GFX.Viewer has no Canvas drawing source")
    }

    func handle(event:@Events.Event) bool {
        if var content = self.session { return content.handle(event) }
        return false
    }

    func update(delta:float) bool {
        if var content = self.session { return content.update(delta) }
        return false
    }

    func accepts_text_input() bool {
        if var content = self.session { return content.accepts_text_input() }
        return false
    }
}

class RenderState {
    private var texture:GPU.Texture? = null
    private var sampler:GPU.Sampler? = null
    private var pipeline:GPU.GraphicsPipeline? = null
    private let background:Color
    private var uploaded_revision:int

    init(
        device:@GPU.Device,
        surface:@GPU.Surface,
        view:@ImageView,
        settings:ImageSettings
    ) {
        let image = view.image()
        var texture = image_texture(device, image)
        upload_image(device, texture, image)
        var filter = GPU.Filter.nearest
        if settings.smooth { filter = GPU.Filter.linear }
        var sampler = device.sampler(GPU.SamplerSettings(
            min_filter:filter,
            mag_filter:filter,
            address_u:GPU.AddressMode.clamp_to_edge,
            address_v:GPU.AddressMode.clamp_to_edge,
            name:"GFX.Viewer sampler"
        ))
        let program = GPU.ShaderProgram.hlsl(file:"../Shaders/Image.hlsl")
        var targets:GPU.ColorTargetFormat[] = []
        targets.append(GPU.ColorTargetFormat(format:surface.format()))
        var pipeline = device.graphics_pipeline(
            program,
            GPU.GraphicsPipelineSettings(
                color_targets:targets,
                name:"GFX.Viewer image pipeline"
            )
        )
        self.texture = texture
        self.sampler = sampler
        self.pipeline = pipeline
        self.background = settings.background
        self.uploaded_revision = view.revision()
    }

    func refresh(device:@GPU.Device, view:@ImageView) {
        if self.uploaded_revision == view.revision() { return }
        let image = view.image()
        var replace_texture = true
        if let current = self.texture {
            replace_texture = current.width() != image.width() || current.height() != image.height()
        }
        if replace_texture {
            device.wait_until_idle()
            self.texture = image_texture(device, image)
        }
        if let current = self.texture {
            upload_image(device, current, image)
            self.uploaded_revision = view.revision()
            return
        }
        panic("GFX.Viewer has no image texture")
    }

    func draw(pass:&GPU.RenderPass, image:@Image) {
        let drawable = pass.size()
        let available_width = drawable.width as float
        let available_height = drawable.height as float
        let image_width = image.width() as float
        let image_height = image.height() as float
        var scale = Math.min(
            available_width / image_width,
            available_height / image_height
        )
        // An image viewer must preserve the image's pixels by default. The
        // historical Viewer never enlarged a small image; doing so made the
        // rasterized Drawing examples look aliased and hid their real output.
        scale = Math.min(scale, 1.0)
        let width = image_width * scale
        let height = image_height * scale
        pass.viewport(
            (available_width - width) * 0.5,
            (available_height - height) * 0.5,
            width,
            height
        )
        if let pipeline = self.pipeline {
            if let texture = self.texture {
                if let sampler = self.sampler {
                    pass.bind(pipeline)
                    pass.fragment_sampler(0, texture, sampler)
                    pass.draw(6)
                    return
                }
            }
        }
        panic("GFX.Viewer has no GPU presentation state")
    }

    func clear_color() Color { return self.background }
}

package func image_application(
    image:Image,
    settings:ImageSettings = ImageSettings()
) Application {
    var application = Application()
    let width = viewer_extent(settings.width, image.width(), 48, 320, 1280)
    let height = viewer_extent(settings.height, image.height(), 48, 240, 800)
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = settings.title
        ..width = width
        ..height = height
    ))
    application.add_plugin(GPUPlugin(GPUPlugin.Settings()
        ..present_on_start = false
    ))
    application.add_resource(ImageView(image))
    application.add_resource(settings)
    application.add_system(Schedule.startup, start_viewer)
    application.add_system(Schedule.render, render_viewer)
    application.add_system(Schedule.shutdown, stop_viewer)
    return application
}

package func canvas_application(
    drawing:AuthoredCanvas,
    settings:CanvasSettings = CanvasSettings()
) Application {
    var application = Application()
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = settings.title
        ..width = settings.width
        ..height = settings.height
    ))
    application.add_plugin(RenderingPlugin(RenderingPlugin.Settings()
        ..clear = settings.background
    ))
    application.add_plugin(Scene2DPlugin())
    application.add_resource(DrawingSource.fixed(drawing))
    application.add_resource(DrawingPresentation())
    application.add_system(Schedule.startup, start_drawing_viewer)
    application.add_system(Schedule.update, resize_drawing_viewer)
    application.add_system(Schedule.shutdown, stop_drawing_viewer)
    return application
}

package func responsive_canvas_application(
    builder:func(int, int) AuthoredCanvas,
    settings:CanvasSettings = CanvasSettings()
) Application {
    var application = Application()
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = settings.title
        ..width = settings.width
        ..height = settings.height
    ))
    application.add_plugin(RenderingPlugin(RenderingPlugin.Settings()
        ..clear = settings.background
    ))
    application.add_plugin(Scene2DPlugin())
    application.add_resource(DrawingSource.responsive(builder))
    application.add_resource(DrawingPresentation())
    application.add_system(Schedule.startup, start_drawing_viewer)
    application.add_system(Schedule.update, resize_drawing_viewer)
    application.add_system(Schedule.shutdown, stop_drawing_viewer)
    return application
}

package func interactive_canvas_application(
    session:CanvasSession,
    settings:CanvasSettings = CanvasSettings()
) Application {
    var application = Application()
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = settings.title
        ..width = settings.width
        ..height = settings.height
    ))
    application.add_plugin(RenderingPlugin(RenderingPlugin.Settings()
        ..clear = settings.background
    ))
    application.add_plugin(TimePlugin())
    application.add_plugin(Scene2DPlugin())
    application.add_resource(DrawingSource.interactive(session))
    application.add_resource(DrawingPresentation())
    application.add_system(Schedule.startup, start_drawing_viewer)
    application.add_system(Schedule.update, interact_drawing_viewer)
    application.add_system(Schedule.update, resize_drawing_viewer)
    application.add_system(Schedule.shutdown, stop_drawing_viewer)
    return application
}

public func show(content:Image) int {
    var application = image_application(content)
    return application.run()
}

public func show(content:Image, settings:ImageSettings) int {
    var application = image_application(content, settings)
    return application.run()
}

public func show(content:AuthoredCanvas) int {
    return show(content, CanvasSettings())
}

public func show(
    drawing:AuthoredCanvas,
    width:int,
    height:int,
    title:str = "GFX canvas viewer"
) int {
    var application = canvas_application(
        drawing,
        CanvasSettings(width:width, height:height, title:title)
    )
    return application.run()
}

public func show(content:AuthoredCanvas, settings:CanvasSettings) int {
    var application = canvas_application(content, settings)
    return application.run()
}

public func show(
    content:func(int, int) AuthoredCanvas,
    settings:CanvasSettings = CanvasSettings()
) int {
    var application = responsive_canvas_application(content, settings)
    return application.run()
}

public func show(
    content:CanvasSession,
    settings:CanvasSettings = CanvasSettings()
) int {
    var application = interactive_canvas_application(content, settings)
    return application.run()
}

func start_drawing_viewer(application:Application) {
    var resources = application.resources()
    let size = resources.get<WindowApi>().size()
    let width = size.x as int
    let height = size.y as int
    var drawing = resources.get<DrawingSource>().drawing(width, height)
    var display:ECS.Entity? = null
    {
        var world = resources.get_mut<ECS.World>()
        display = spawn_drawing(world, drawing, width, height, size)
    }
    if let entity = display {
        var presentation = resources.get_mut<DrawingPresentation>()
        presentation.display = entity
        presentation.display_width = width
        presentation.display_height = height
        return
    }
    panic("GFX.Viewer has no drawing")
}

func resize_drawing_viewer(
    window:@WindowApi,
    world:&ECS.World,
    presentation:&DrawingPresentation,
    source:@DrawingSource
) {
    let size = window.size()
    let width = size.x as int
    let height = size.y as int
    if width <= 0 || height <= 0 { return }
    if width == presentation.display_width && height == presentation.display_height { return }
    if source.responsive {
        var drawing = source.drawing(width, height)
        replace_drawing(world, presentation, drawing, width, height, size)
        return
    }
    if let display = presentation.display {
        world.update<Scene2D.Canvas>(display, func(canvas:&Scene2D.Canvas) {
            canvas.size = size
        })
    }
    presentation.display_width = width
    presentation.display_height = height
}

func interact_drawing_viewer(
    input:@InputApi,
    time:@Resources.FrameTime,
    window:@WindowApi,
    world:&ECS.World,
    presentation:&DrawingPresentation,
    source:&DrawingSource
) {
    if !source.interactive { return }
    var changed = source.update(time.delta)
    for event in input.events() {
        changed = source.handle(event) || changed
    }

    let accepts_text = source.accepts_text_input()
    if accepts_text && !window.is_text_input_active() { window.start_text_input() }
    elif !accepts_text && window.is_text_input_active() { window.stop_text_input() }

    if !changed { return }
    let size = window.size()
    let width = size.x as int
    let height = size.y as int
    if width <= 0 || height <= 0 { return }
    var drawing = source.drawing(width, height)
    replace_drawing(world, presentation, drawing, width, height, size)
}

func replace_drawing(
    world:&ECS.World,
    presentation:&DrawingPresentation,
    drawing:AuthoredCanvas,
    width:int,
    height:int,
    size:Math.Vec2
) {
    if width == presentation.display_width && height == presentation.display_height {
        if let display = presentation.display {
            if world.is_alive(display) {
                world.update<Scene2D.Canvas>(display, func(canvas:&Scene2D.Canvas) {
                    canvas.replace(drawing)
                    canvas.size = size
                })
                return
            }
        }
    }
    if let display = presentation.display {
        if world.is_alive(display) { world.destroy(display) }
    }
    presentation.display = spawn_drawing(world, drawing, width, height, size)
    presentation.display_width = width
    presentation.display_height = height
}

func stop_drawing_viewer(application:Application) {
    var resources = application.resources()
    var presentation = resources.remove<DrawingPresentation>()
    assert(presentation != null)
    var source = resources.remove<DrawingSource>()
    assert(source != null)
}

func spawn_drawing(
    world:&ECS.World,
    drawing:AuthoredCanvas,
    width:int,
    height:int,
    size:Math.Vec2
) ECS.Entity {
    return world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform())
        ..with(Scene2D.Canvas(drawing, width, height)
            ..size = size
            ..space = Scene2D.CanvasSpace.viewport
            ..pivot = Math.Vec2()
        )
    )
}

func start_viewer(application:Application) {
    var resources = application.resources()
    let settings = resources.remove<ImageSettings>()
    if let configured = settings {
        var state:RenderState? = null
        {
            let device = resources.get<GPU.Device>()
            let surface = resources.get<GPU.Surface>()
            let view = resources.get<ImageView>()
            state = RenderState(device, surface, view, configured)
        }
        if let ready = state {
            resources.insert(ready)
            return
        }
    }
    panic("GFX.Viewer has no settings")
}

func render_viewer(
    device:@GPU.Device,
    surface:@GPU.Surface,
    view:@ImageView,
    state:&RenderState
) {
    state.refresh(device, view)
    var commands = device.commands()
    if var pass = commands.render(surface, state.clear_color()) {
        state.draw(pass, view.image())
        pass.finish()
    }
    commands.submit()
}

func stop_viewer(application:Application) {
    var resources = application.resources()
    var state = resources.remove<RenderState>()
    assert(state != null)
    var view = resources.remove<ImageView>()
    assert(view != null)
}

func image_texture(device:@GPU.Device, image:@Image) GPU.Texture {
    return device.texture(GPU.TextureSettings(
        format:GPU.TextureFormat.rgba8_unorm,
        width:image.width(),
        height:image.height(),
        usage:GPU.TextureUsage.for_sampling(),
        name:"GFX.Viewer image"
    ))
}

func upload_image(device:@GPU.Device, texture:GPU.Texture, image:@Image) {
    var pixels = image.pixels()
    var upload = device.upload_buffer(pixels.count(), "GFX.Viewer image upload")
    upload.write(@pixels[0:pixels.count()])
    var commands = device.commands()
    var transfer = commands.copy()
    transfer.upload(
        upload,
        GPU.TextureRegion(
            texture:texture,
            width:image.width(),
            height:image.height()
        ),
        image.width(),
        image.height()
    )
    transfer.finish()
    commands.submit()
}

func viewer_extent(
    requested:int,
    content:int,
    padding:int,
    minimum:int,
    maximum:int
) int {
    if requested > 0 { return requested }
    let padded = content + padding
    if padded < minimum { return minimum }
    if padded > maximum { return maximum }
    return padded
}
