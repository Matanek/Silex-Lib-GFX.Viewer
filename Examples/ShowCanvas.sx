use GFX.Canvas
use GFX.Color
use GFX.Viewer
use STD.Math

func main() {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(160.0, 120.0), 72.0),
            Canvas.Fill.solid(Color.sky_400())
        )
    })
    Viewer.show(drawing, Viewer.CanvasSettings(
        width:320,
        height:240,
        title:"GFX.Viewer — Canvas"
    ))
}
