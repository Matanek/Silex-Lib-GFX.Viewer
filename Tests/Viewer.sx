use GFX.Application
use GFX.Assets.Image
use GFX.Canvas
use GFX.Color
use GFX.ECS
use GFX.Input
use GFX.Scene2D
use GFX.Viewer
use GFX.Window
use GFX.Window.Plugin as WindowPlugin
use STD.Math

func replace_and_stop(
    view:&Viewer.ImageView,
    controller:&Application.Controller
) {
    view.replace(Image.solid(Color.indigo_500()))
    assert(view.revision() == 2)
    controller.stop()
}

func resize_vector_viewer(window:&Window) {
    window.resize(Math.Vec2(96.0, 80.0))
}

func verify_vector_viewer_resize(
    world:@ECS.World,
    window:@Window,
    controller:&Application.Controller
) {
    let expected = window.size()
    for entity in world.entities() {
        if world.has<Scene2D.Canvas>(entity) {
            let canvas = world.get<Scene2D.Canvas>(entity)
            if canvas.size == expected {
                controller.stop()
                return
            }
        }
    }
    panic("GFX.Viewer vector content did not follow its resized window")
}

func responsive_drawing(width:int, height:int) Canvas {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(width as float, height as float)),
            Canvas.Fill.solid(Color.violet_500())
        )
    })
    return drawing
}

class InteractiveDrawing:Viewer.CanvasSession {
    var handled_events:int = 0
    var updated_frames:int = 0

    func drawing(width:int, height:int) Canvas {
        return responsive_drawing(width, height)
    }

    func handle(event:@Input.Event) bool {
        self.handled_events++
        return true
    }

    func update(delta:float) bool {
        self.updated_frames++
        return false
    }

    func accepts_text_input() bool { return false }
}

func verify_interactive_viewer(
    session:@InteractiveDrawing,
    controller:&Application.Controller
) {
    if session.handled_events > 0 { controller.stop() }
}

func verify_responsive_viewer_resize(
    world:@ECS.World,
    window:@Window,
    controller:&Application.Controller
) {
    let expected = window.size()
    for entity in world.entities() {
        if world.has<Scene2D.Canvas>(entity) {
            let canvas = world.get<Scene2D.Canvas>(entity)
            if canvas.width() == expected.x as int &&
                canvas.height() == expected.y as int && canvas.size == expected
            {
                controller.stop()
                return
            }
        }
    }
    panic("GFX.Viewer responsive Canvas was not rebuilt for its window")
}

test "display and replace an image through the viewer runtime" {
    var application = Viewer.image_application(
        Image.solid(Color.sky_400())
    )
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "GFX.Viewer test"
        ..width = 64
        ..height = 64
        ..hidden = true
    ))
    assert(application.has_plugin("GFX.Window.Plugin"))
    application.add_system(Application.Schedule.startup, replace_and_stop)
    application.run()
    assert(application.has_plugin("GFX.Input.Plugin"))
    assert(application.has_plugin("GFX.GPU.Plugin"))
}

test "display a canvas through the retained vector viewer" {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(32.0), 18.0),
            Canvas.Fill.solid(Color.sky_400())
        )
    })
    var application = Viewer.canvas_application(
        drawing,
        Viewer.CanvasSettings(width:64, height:64)
    )
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "GFX.Viewer vector test"
        ..width = 64
        ..height = 64
        ..hidden = true
    ))
    application.add_system(Application.Schedule.startup, resize_vector_viewer)
    application.add_system(Application.Schedule.update, verify_vector_viewer_resize)
    application.run()
    assert(application.has_plugin("GFX.Scene2D.Plugin"))
    assert(application.has_plugin("GFX.Rendering.Plugin"))
}

test "rebuild responsive Canvas content for a resized window" {
    var application = Viewer.responsive_canvas_application(
        responsive_drawing,
        Viewer.CanvasSettings(width:64, height:64)
    )
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "GFX.Viewer responsive test"
        ..width = 64
        ..height = 64
        ..hidden = true
    ))
    application.add_system(Application.Schedule.startup, resize_vector_viewer)
    application.add_system(Application.Schedule.update, verify_responsive_viewer_resize)
    application.run()
}

test "forward window events to an interactive Canvas session" {
    var session = InteractiveDrawing()
    var application = Viewer.interactive_canvas_application(
        session,
        Viewer.CanvasSettings(width:64, height:64)
    )
    application.add_resource(session)
    application.add_plugin(WindowPlugin(WindowPlugin.Settings()
        ..title = "GFX.Viewer interactive test"
        ..width = 64
        ..height = 64
        ..hidden = true
    ))
    application.add_system(Application.Schedule.startup, resize_vector_viewer)
    application.add_system(Application.Schedule.update, verify_interactive_viewer)
    application.run()
    assert(session.handled_events > 0)
    assert(session.updated_frames > 0)
}
