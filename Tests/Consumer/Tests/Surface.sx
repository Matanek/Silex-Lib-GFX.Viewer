use GFX.Assets.Image
use GFX.Canvas
use GFX.Color
use GFX.Input
use GFX.Viewer
use STD.Math

struct ConsumerSession:Canvas.Session {
    func drawing(width:int, height:int) Canvas { return Canvas() }
    func update(delta:float) bool { return false }
    func handle(event:@Input.Event) bool { return false }
    func accepts_text_input() bool { return false }
}

func display_image(image:Image) int {
    return Viewer.show(image, Viewer.ImageSettings(
        title:"Generated image",
        width:640,
        height:480,
        smooth:false
    ))
}

func display_canvas(drawing:Canvas) int {
    return Viewer.show(drawing, Viewer.CanvasSettings(
        width:960,
        height:640,
        title:"Generated chart"
    ))
}

func responsive_canvas(width:int, height:int) Canvas {
    return Canvas()
}

func animate_canvas(
    frame:@Viewer.CanvasFrame,
    drawing:&Canvas
) {
    if drawing.is_empty() {
        drawing.paint(func(painter:&Canvas.Painter) {
            painter.fill(
                Canvas.Circle(Math.Vec2(24.0), 12.0 + frame.delta),
                Canvas.Fill.solid(Color.sky_400())
            )
        })
    }
}

func display_responsive_canvas() int {
    return Viewer.show(responsive_canvas, Viewer.CanvasSettings(
        width:960,
        height:640,
        title:"Responsive UI"
    ))
}

func display_animated_canvas() int {
    return Viewer.show(animate_canvas, Viewer.CanvasSettings(
        width:640,
        height:480,
        title:"Animated Canvas"
    ))
}

func display_interactive_canvas() int {
    return Viewer.show(ConsumerSession(), Viewer.CanvasSettings(
        width:960,
        height:640,
        title:"Interactive UI"
    ))
}

func display_closing_interactive_canvas() int {
    return Viewer.show_until(
        ConsumerSession(),
        func() bool { return true },
        Viewer.CanvasSettings(
            width:960,
            height:640,
            title:"Transient UI"
        )
    )
}

test "consume the direct Viewer show surface" {
    let image = Viewer.ImageSettings(title:"Image", smooth:false)
    assert(image.title == "Image")
    assert(!image.smooth)

    let canvas = Viewer.CanvasSettings(
        width:800,
        height:600,
        title:"Canvas",
        position:Math.Vec2(12.0, 8.0),
        anchor:Math.Vec2(0.5),
        text_mode:Viewer.CanvasTextMode.vector,
        coverage_density:2.0
    )
    assert(canvas.width == 800)
    assert(canvas.height == 600)
    assert(canvas.title == "Canvas")
    assert(canvas.position == Math.Vec2(12.0, 8.0))
    assert(canvas.anchor == Math.Vec2(0.5))
    assert(canvas.text_mode == Viewer.CanvasTextMode.vector)
    assert(canvas.coverage_density == 2.0)
}
